# MQTT Configuration
MQTT_HOST=192.168.1.100
MQTT_PORT=1883
MQTT_FRIGATE_TOPIC=frigate/events
MQTT_RESULT_TOPIC=home/face_recognition/person
MQTT_HA_DISCOVERY_PREFIX=homeassistant

# Frigate Configuration
FRIGATE_API_URL=http://192.168.1.100:5000
FRIGATE_SNAPSHOT_RETENTION_HOURS=24

# Face Recognition Engine
INSIGHTFACE_MODEL=buffalo_sc
INSIGHTFACE_PROVIDERS=CPUExecutionProvider
SIMILARITY_THRESHOLD_KNOWN=0.50
SIMILARITY_THRESHOLD_UNKNOWN=0.35

# Database
DATA_DIR=/app/data
DATABASE_URL=sqlite:////app/data/face_db.db

# Web UI Authentication
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme
AUTH_ENABLED=true

# Logging
LOG_LEVEL=INFO

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
DEBUG=false
